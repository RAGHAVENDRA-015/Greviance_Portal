# ==============================================================
# .env.example — Safe template to commit to version control.
#
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ==============================================================

# --------------------------------------------------
# MongoDB Atlas
# --------------------------------------------------
# Connection string from: Atlas Dashboard → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/

# Database name (created automatically on first write)
DATABASE_NAME=grievance_portal

# --------------------------------------------------
# Firebase Admin SDK
# --------------------------------------------------
# Path to your service account JSON file.
# Download from: Firebase Console → Project Settings → Service Accounts
# → Generate new private key
FIREBASE_CREDENTIALS=firebase/firebase-service-account.json

# --------------------------------------------------
# Google Gemini API
# --------------------------------------------------
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# --------------------------------------------------
# CORS (optional — defaults to localhost for development)
# --------------------------------------------------
# Comma-separated list of allowed frontend origins.
# Example for production: https://grievanceportal.gov.in
# Leave blank to use localhost defaults (3000, 5173).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
